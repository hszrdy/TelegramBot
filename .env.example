# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id
GOOGLE_APPLICATION_CREDENTIALS=./firebase-credentials.json

# n8n webhooks (replace with actual URLs of n8n webhooks)
N8N_CHECKOUT_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/checkout
N8N_MENUS_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/menus
N8N_AI_INTEGRATION_URL=https://your-n8n-instance.app.n8n.cloud/webhook/ai-integration

# Your Railway URL (set after deploying)
WEBHOOK_URL=https://your-app.railway.app

##
# IMPORTANT!
# DO NOT COMMIT .ENV FILES INTO THE REPO
# OR ANYTHING THAT HAS API/TOKEN KEYS
##